# 依赖
node_modules/

# 构建产物
dist/
app/dist/
.vite/
app/node_modules/.vite/
app/node_modules/.vite-temp/

# 地图烘焙缓存（体积大，可用 Tools/bake_*.py 重新生成）
Tools/.tile-cache/

# pmtiles CLI（17 MB 二进制，Tools/fetch_basemap.mjs 自动下载）
Tools/bin/

# 本地底图包与派生样式（体积大，用 Tools/fetch_basemap.mjs 重新生成）
app/public/data/tiles/

# 本地 DEM 瓦片（15 MB，用 Tools/bake_dem.py 重新生成）
app/public/data/dem/

# 运行时存档
Saves/*
!Saves/.gitkeep

# Python 缓存
__pycache__/
*.pyc


# 烘焙服务运行时生成的地图库索引
app/public/data/zones.json
app/dist/data/zones.json

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# 区域坡度瓦片（体积大，用 Tools/bake_slope.py 从 dem/<key> 重烘）
app/public/data/slope/germany/
