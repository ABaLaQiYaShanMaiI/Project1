# 依赖
node_modules/

# 构建产物
dist/
app/dist/
.vite/
app/node_modules/.vite/
app/node_modules/.vite-temp/

# 地图烘焙缓存（体积大，可用 Tools/bake_*.py 重新生成）
Tools/.tile-cache/

# pmtiles CLI（17 MB 二进制，Tools/fetch_basemap.mjs 自动下载）
Tools/bin/

# 本地底图包与派生样式（体积大，用 Tools/fetch_basemap.mjs 重新生成）
app/public/data/tiles/

# 本地 DEM 瓦片（15 MB，用 Tools/bake_dem.py 重新生成）
app/public/data/dem/

# 运行时存档
Saves/*
!Saves/.gitkeep

# 样式快照工具的 tsc 编译缓存（Tools/style_snapshot.mjs 生成）
Tools/.style-cache/

# Python 缓存
__pycache__/
*.pyc


# 烘焙服务运行时生成的地图库索引
app/public/data/zones.json
app/dist/data/zones.json

# 自动化验证用的临时浏览器 profile（Tools/dev_*.mjs / 无头 Edge）
.edge-profile

# 日志与临时文件
*.log
*.err
npm-debug.log*
pnpm-debug.log*
vite.err
.edge-tmp/

.DS_Store
Thumbs.db
desktop.ini

# 编辑器
.vscode/
.idea/
*.swp

# 坡度瓦片与美术资源按决定入库（v1.38）：slope/germany（约 46 MB）不再忽略，
# 未来的美术资源（Arts/ 与 public 下的图像产物）一律跟踪，不再新增忽略规则。
